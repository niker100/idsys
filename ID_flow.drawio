        <mxCell id="lVtnfKb0ssmyyP45lPF8-1533" value="&lt;b&gt;Message Space&lt;/b&gt; \( \mathcal{U} \)&lt;div&gt;\(q\) Feldgröße, hier \(q=2^2=4\)&lt;/div&gt;&lt;div&gt;\(k\) Nachrichtenlänge mit \(q\)-ary symbols, hier = 5&lt;/div&gt;&lt;div&gt;\( \mathbb{F} \) Galois Feld&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Variation: Message Patterns&lt;/b&gt;&lt;/div&gt;&lt;div&gt;\( \mathcal{U} \subset \mathbb{F}_q^k\)&lt;/div&gt;&lt;div&gt;schönes Bildchen&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=20;container=0;absoluteArcSize=1;arcSize=75;" vertex="1" parent="1">
          <mxGeometry x="655" y="560" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lVtnfKb0ssmyyP45lPF8-1534" value="&lt;b&gt;Message Selection&lt;/b&gt;&lt;div&gt;random oder anwendungsspezifisch&lt;/div&gt;&lt;div&gt;\( v \in {\hat{v}_p, \hat{v}_n} \)&lt;/div&gt;&lt;div&gt;\( \mathbb{P}(\hat{v}_p) = p_{tp} \) true positive probability, muss nicht 1/2 sein.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Variation: K-Identification&lt;/b&gt;&lt;/div&gt;&lt;div&gt;\( \boldsymbol{B} \subseteq \mathcal{U} \)&lt;/div&gt;&lt;div&gt;schönes Bildchen&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F3FF;strokeColor=#D6CFEA;opacity=30;absoluteArcSize=1;arcSize=75;imageHeight=24;strokeWidth=2;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="855" y="560" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lVtnfKb0ssmyyP45lPF8-1535" value="&lt;b&gt;&lt;font&gt;Encoding&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;font-family: monospace; font-size: 0px; text-align: start; text-wrap-mode: nowrap;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-family: Helvetica; font-size: 12px; text-align: center; text-wrap-mode: wrap;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;\( f_\mathcal{T}: \mathbb{F}_q^k \to \mathbb{F}_q^n, \) \( \boldsymbol{u} \mapsto \mathcal{T}_u \)&lt;/font&gt;&lt;/span&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%26lt%3Bdiv%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bbackground-color%3A%20transparent%3B%20color%3A%20light-dark(rgb(34%2C%2034%2C%2034)%2C%20rgb(208%2C%20208%2C%20208))%3B%26quot%3B%26gt%3B%5C(%20f_%5Cmathcal%7BT%7D%3A%20%5Cmathbb%7BF%7D_q%5Ek%20%5Cto%20%5Cmathbb%7BF%7D_q%5En%2C%20%5C)%20%5C(%20%5Cboldsymbol%7Bu%7D%20%5Cmapsto%20%5Cmathcal%7BT%7D_u%20%5C)%26lt%3B%2Fspan%26gt%3B%26lt%3B%2Fdiv%26gt%3B%22%20style%3D%22text%3Bhtml%3D1%3Balign%3Dcenter%3BverticalAlign%3Dmiddle%3BwhiteSpace%3Dwrap%3Brounded%3D0%3BfontColor%3D%23222222%3B%22%20vertex%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%22417%22%20y%3D%22600.13%22%20width%3D%22185%22%20height%3D%2230%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/font&gt;&lt;/span&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font&gt;entweder \((n,k,d)_q \) FEC&lt;/font&gt;&lt;/div&gt;&lt;div&gt;\(f_\mathcal{T}: \mathcal{T} = \boldsymbol{u} G\)&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;linear&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;\(n\) Output-Größe&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;\(k\) Input-Größe&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;\(d\) min. Hamming Distanz&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;\(q\) Feldgröße&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;\( G \in \mathbb{F}_q^{k \times n} \) Generator-Matrix&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;Beispiel zeigt \((8,5,2)_4\) FEC&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;z.B. RS, RM&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;oder Hash&lt;/span&gt;&lt;/div&gt;&lt;div&gt;\(f_\mathcal{T}: \mathbb{F}_q^k \to \{0,1\}^l \to \mathbb{F}_q^n\)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;\(l\) Hash Länge (128 bit bei Sha1, 256 bit bei Sha256),&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;danach gruppierung \(l\) bits in \(n\) symbole,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;nichtlinear&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#F1C7C7;opacity=30;arcSize=75;absoluteArcSize=1;strokeWidth=2;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="1055" y="560" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lVtnfKb0ssmyyP45lPF8-1536" value="&lt;b&gt;Tag Extraction&lt;/b&gt;&lt;div&gt;festes pi, common randomness bei beiden seiten oder wird jedes mal mitgeschickt&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E0;strokeColor=#D7B982;opacity=25;arcSize=75;imageWidth=24;absoluteArcSize=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1255" y="560" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lVtnfKb0ssmyyP45lPF8-1537" value="&lt;b&gt;Rest&lt;/b&gt;&lt;div&gt;kurz beschreiben was noch passiert, datenrate und so&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Variation: Multi Tag&lt;/b&gt;&lt;/div&gt;&lt;div&gt;vorteile, nachteile&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#E6E6E6;opacity=30;arcSize=75;absoluteArcSize=1;strokeWidth=2;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="1455" y="560" width="200" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
